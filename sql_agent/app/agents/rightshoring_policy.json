  "FINANCIAL_GLOSSARY_TERMS": {
    "high_risk_profile": "A rating assigned to customers or loans with higher default probability. Based on failed payments, high debt-to-income ratio, or adverse credit events.",
    "low_risk_profile": "Customers with stable payment history, good credit scores, and strong financial indicators. Lower default probability.",
    "medium_risk_profile": "Moderate risk classification. Some payment variations or moderate debt but generally acceptable financial health.",
    "npa": "Non-Performing Asset - Loan not serviced for 90+ days. Borrower failed to make scheduled payments.",
    "aml": "Anti-Money Laundering - Compliance to prevent financial institutions from supporting money laundering or terrorist financing.",
    "kyc": "Know Your Customer - Verification to authenticate customer identity and assess financial risk.",
    "tenure": "Duration for which a loan is granted, typically in months or years.",
    "interest_rate": "Percentage charged by lender as cost of borrowing, usually annual percentage (APR).",
    "loan_status": "Current state of loan - ACTIVE (ongoing), CLOSED (repaid), or DEFAULTED (not serviced).",
